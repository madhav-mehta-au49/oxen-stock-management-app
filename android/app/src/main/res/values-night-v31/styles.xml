<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 12+ masks launch icons to a circle. Reveal the complete
         horizontal wordmark in Flutter instead of clipping its lettering. -->
    <style name="LaunchTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowSplashScreenBackground">@android:color/white</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/splash_empty</item>
        <item name="android:windowSplashScreenAnimationDuration">0</item>
        <item name="android:windowBackground">@android:color/white</item>
    </style>
</resources>