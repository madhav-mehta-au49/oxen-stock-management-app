<?xml version="1.0" encoding="utf-8"?>
<!-- Seamless handover to the animated Flutter splash; no logo container. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@android:color/white" />
    <item android:width="240dp" android:height="85dp" android:gravity="center">
        <bitmap android:gravity="fill" android:src="@drawable/splash_wordmark" />
    </item>
</layer-list>